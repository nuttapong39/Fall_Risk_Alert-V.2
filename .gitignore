# --- Secrets / credentials (ไฟล์จริงที่มี credentials) ---
secrets/db_config.json
secrets/moph_keys.json
secrets/site_config.json
secrets/flex_themes.json
secrets/module_filters.json
secrets/moph_endpoint.json
secrets/*.bak
*.env
.env
.env.*
# อนุญาต .example.json ให้อยู่ใน git เพื่อเป็น template สำหรับผู้ติดตั้ง
!secrets/db_config.example.json
!secrets/moph_keys.example.json
!secrets/site_config.example.json
!secrets/flex_themes.example.json
!secrets/module_filters.example.json
!secrets/moph_endpoint.example.json

# --- Logs ---
logs/
*.log

# --- PHP Composer vendor ---
vendor/

# --- OS / Editor junk (optional but recommended) ---
.DS_Store
Thumbs.db
.vscode/

# --- Agent / skill scaffolding (dev tooling เฉพาะเครื่อง ไม่ share) ---
.agents/
.claude/

# --- Local artifacts (ไฟล์เฉพาะเครื่อง ไม่ขึ้น repo) ---
# รูปทดสอบ Flex
flex-test*.png
# Task Scheduler export ที่หลุดใน root (เฉพาะเครื่อง) — ยัง ignore
*_Alert_Auto Sender.xml
# ...ยกเว้นชุด import ใน task/ (แจกให้ รพ.อื่นติดตั้งด้วย install_tasks.bat)
!task/*.xml
